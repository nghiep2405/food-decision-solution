# Copy this file to .env. Never commit the real .env or API keys.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
APP_HTTP_TIMEOUT_SECONDS=10
FOOD_DECISION_DB_PATH=

# -----------------------------------------------------------------------------
# Menu OCR and menu structuring
# Used by both methods of POST /api/v1/menus/ocr:
# - visual: sends the menu image directly to a vision-capable model.
# - text_pipeline: Tesseract extracts text, then the model structures it as JSON.
#
# FACULTY_AI_API_URL accepts either an OpenAI-compatible base URL (for example
# https://provider.example/v1) or the full /chat/completions endpoint.
# FACULTY_AI_MODEL must support images when method=visual is selected.
# Leave the key empty until it is provided. OCR returns HTTP 503 without all
# three values.
# -----------------------------------------------------------------------------
FACULTY_AI_API_URL=https://api-fit.hcmus.edu.vn/v1
FACULTY_AI_API_KEY=
FACULTY_AI_MODEL=Qwen-27B

# Required only by method=text_pipeline. Leave TESSERACT_CMD empty when the
# executable is already in PATH. Forward slashes are accepted on Windows.
TESSERACT_CMD=
TESSERACT_LANG=vie+eng
TESSERACT_DATA_DIR=

# -----------------------------------------------------------------------------
# Recommendation and ranking agent
# Uses an OpenAI-compatible Chat Completions API. When URL/key are missing or
# the provider fails, the service keeps working with deterministic ranking and
# reports the fallback in recommendation metadata.
#
# The code also accepts the legacy aliases FACULTY_API_BASE_URL,
# FACULTY_API_KEY and FACULTY_TEXT_MODEL. Prefer the canonical AI_* names below.
# If the same Faculty API/model supports OCR and text ranking, these values may
# point to the same provider as the FACULTY_AI_* values above.
# -----------------------------------------------------------------------------
AI_API_BASE_URL=https://api-fit.hcmus.edu.vn/v1
AI_API_KEY=
AI_TEXT_MODEL=Qwen-27B

# -----------------------------------------------------------------------------
# Review Reliability explanation agent
# The review algorithms run locally. The agent only summarizes detected
# signals. With USE_FAKE_AGENT=true or an empty LLM_API_KEY, the backend uses a
# local deterministic explanation, so the feature still works without a key.
#
# COLAB_API_URL is the exact custom endpoint, not a Chat Completions base URL.
# It must accept {prompt, temperature, max_tokens} and return an "output" field
# containing JSON text such as {"reasons": ["..."]}.
# Set USE_FAKE_AGENT=false only after this endpoint and key are available.
# -----------------------------------------------------------------------------
USE_FAKE_AGENT=true
COLAB_API_URL=http://127.0.0.1:8001/generate
LLM_API_KEY=

# -----------------------------------------------------------------------------
# Optional live restaurant discovery through OpenStreetMap Overpass
# This is not an agent. Keep disabled to use the local SQLite database.
# -----------------------------------------------------------------------------
ENABLE_EXTERNAL_PLACES=false
EXTERNAL_PLACES_API_URL=https://overpass-api.de/api/interpreter
